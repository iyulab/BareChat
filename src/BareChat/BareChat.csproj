<Project Sdk="Microsoft.NET.Sdk">

  <!-- TFM/Nullable/ImplicitUsings/LangVersion and package metadata come from Directory.Build.props. -->
  <PropertyGroup>
    <Description>BareChat ASP.NET Core add-on: SignalR hub, REST, embedded UI, SQLite storage, Web Push.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BareChat.Core\BareChat.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web Push (VAPID + RFC 8291 payload encryption) for the WebPushChannel wake-up transport.
         net6.0 asset uses BCL crypto (no BouncyCastle on net10). Confined to this ASP.NET package; Core stays dependency-free. -->
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Override transitive SQLitePCLRaw.lib.e_sqlite3 2.1.11 (bundles SQLite <3.50.2, CVE-2025-6965).
         3.50.3 bundles SQLite 3.50.3. Flows downstream to Tests/Sample. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
  </ItemGroup>

</Project>
